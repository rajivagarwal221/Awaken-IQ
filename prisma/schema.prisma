// ============================================================================
// AwakenIQ — LMS & Student Enrollment Portal
// Normalized PostgreSQL schema (Prisma ORM)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  DRAFT              // Save Draft — form started, not submitted
  SUBMITTED          // form complete, awaiting payment step
  PENDING_PAYMENT     // payment initiated, gateway callback not yet received
  PAID
  APPROVED
  REJECTED
  CANCELLED
}

enum AccessType {
  FULL
  PARTIAL
  MODULE_BASED
  TIME_BASED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  MANUAL
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

// ----------------------------------------------------------------------------
// AUTH / ADMIN
// ----------------------------------------------------------------------------

model Admin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions  AdminSession[]
  auditLogs AuditLog[]

  @@index([email])
  @@map("admins")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("admin_sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?  @map("admin_id")
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// PARENT / STUDENT (Screens 1 & 2)
// ----------------------------------------------------------------------------

model Parent {
  id               String  @id @default(uuid())
  fullName         String  @map("full_name")
  relationship     String  // e.g. Mother, Father, Guardian
  mobile           String
  alternateMobile  String? @map("alternate_mobile")
  email            String  @unique
  passwordHash     String  @map("password_hash")

  residentialAddress String @map("residential_address")
  city               String
  state              String
  pincode            String

  isEmailVerified Boolean @default(false) @map("is_email_verified")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  students  Student[]
  payments  Payment[]

  @@index([email])
  @@index([mobile])
  @@map("parents")
}

model Student {
  id       String   @id @default(uuid())
  parentId String   @map("parent_id")
  parent   Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  fullName    String   @map("full_name")
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  gender      Gender
  classGrade  String   @map("class_grade")
  schoolName  String   @map("school_name")

  hasSpecialNeeds        Boolean @default(false) @map("has_special_needs")
  specialNeedsDescription String? @map("special_needs_description")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  enrollments    Enrollment[]
  payments       Payment[]
  videoProgress  VideoProgress[]
  attendance     Attendance[]
  feedback       Feedback[]
  certificates   Certificate[]
  improvementVideos StudentImprovementVideo[]

  @@index([parentId])
  @@map("students")
}

model StudentImprovementVideo {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title   String
  url     String
  addedAt DateTime @default(now()) @map("added_at")

  @@index([studentId])
  @@map("student_improvement_videos")
}

// ----------------------------------------------------------------------------
// PROGRAMS & LESSONS (Screen 3)
// ----------------------------------------------------------------------------

model Program {
  id    String @id @default(uuid())
  title String
  slug  String @unique

  description   String
  durationText  String  @map("duration_text")
  ageGroup      String  @map("age_group")

  price            Decimal @db.Decimal(10, 2)
  registrationFee  Decimal @default(0) @map("registration_fee") @db.Decimal(10, 2)
  gstPercentage    Decimal @default(18) @map("gst_percentage") @db.Decimal(5, 2)
  materialsFee     Decimal @default(0) @map("materials_fee") @db.Decimal(10, 2)

  thumbnailUrl   String? @map("thumbnail_url")
  syllabusPdfUrl String? @map("syllabus_pdf_url")

  status ProgramStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lessons     Lesson[]
  enrollments Enrollment[]
  payments    Payment[]
  attendance  Attendance[]
  feedback    Feedback[]
  certificates Certificate[]

  @@index([status])
  @@map("programs")
}

model Lesson {
  id        String  @id @default(uuid())
  programId String  @map("program_id")
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  bunnyVideoId    String  @map("bunny_video_id")
  lessonOrder     Int     @map("lesson_order")
  durationSeconds Int     @map("duration_seconds")
  isFree          Boolean @default(false) @map("is_free")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  videoProgress   VideoProgress[]
  enrollmentAccess EnrollmentLessonAccess[]

  @@unique([programId, lessonOrder])
  @@index([programId])
  @@map("lessons")
}

// ----------------------------------------------------------------------------
// ENROLLMENT (Screens 3-5)
// ----------------------------------------------------------------------------

model Enrollment {
  id        String  @id @default(uuid())
  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId String  @map("program_id")
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  status         EnrollmentStatus @default(DRAFT)
  accessType     AccessType       @default(FULL) @map("access_type")

  enrollmentDate DateTime? @map("enrollment_date")
  accessStart    DateTime? @map("access_start")
  accessEnd      DateTime? @map("access_end")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  payments     Payment[]
  lessonAccess EnrollmentLessonAccess[]

  @@unique([studentId, programId])
  @@index([status])
  @@map("enrollments")
}

model EnrollmentLessonAccess {
  id           String     @id @default(uuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String     @map("lesson_id")
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  accessGranted Boolean   @default(true) @map("access_granted")
  grantedAt     DateTime  @default(now()) @map("granted_at")
  expiresAt     DateTime? @map("expires_at")

  @@unique([enrollmentId, lessonId])
  @@map("enrollment_lesson_access")
}

// ----------------------------------------------------------------------------
// PAYMENTS (Screen 4)
// ----------------------------------------------------------------------------

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  validFrom     DateTime     @map("valid_from")
  validTo       DateTime     @map("valid_to")
  maxUses       Int?         @map("max_uses")
  usedCount     Int          @default(0) @map("used_count")
  isActive      Boolean      @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  payments Payment[]

  @@map("coupons")
}

model Payment {
  id           String      @id @default(uuid())
  parentId     String      @map("parent_id")
  parent       Parent      @relation(fields: [parentId], references: [id], onDelete: Restrict)
  studentId    String      @map("student_id")
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  programId    String      @map("program_id")
  program      Program     @relation(fields: [programId], references: [id], onDelete: Restrict)
  enrollmentId String      @map("enrollment_id")
  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  amount           Decimal @db.Decimal(10, 2)
  registrationFee  Decimal @default(0) @map("registration_fee") @db.Decimal(10, 2)
  gstAmount        Decimal @default(0) @map("gst_amount") @db.Decimal(10, 2)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  couponId         String? @map("coupon_id")
  coupon           Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  totalPayable     Decimal @map("total_payable") @db.Decimal(10, 2)
  currency         String  @default("INR")

  gateway           PaymentGateway @default(RAZORPAY)
  razorpayOrderId   String?        @map("razorpay_order_id")
  razorpayPaymentId String?        @map("razorpay_payment_id")
  transactionId     String?        @map("transaction_id")

  status      PaymentStatus @default(INITIATED)
  paymentDate DateTime?     @map("payment_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// PROGRESS / ATTENDANCE / FEEDBACK / CERTIFICATES
// ----------------------------------------------------------------------------

model VideoProgress {
  id        String  @id @default(uuid())
  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String  @map("lesson_id")
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  watchPercentage Decimal   @default(0) @map("watch_percentage") @db.Decimal(5, 2)
  completed       Boolean   @default(false)
  lastPositionSeconds Int   @default(0) @map("last_position_seconds")
  completedAt     DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@map("video_progress")
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId String?  @map("program_id")
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  sessionDate DateTime          @map("session_date") @db.Date
  status      AttendanceStatus
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, programId, sessionDate])
  @@index([studentId])
  @@map("attendance")
}

model Feedback {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId String?  @map("program_id")
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  rating   Int
  comments String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([programId])
  @@map("feedback")
}

model Certificate {
  id        String  @id @default(uuid())
  studentId String  @map("student_id")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId String  @map("program_id")
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  certificateNumber String   @unique @map("certificate_number")
  certificateUrl    String   @map("certificate_url")
  issuedDate        DateTime @map("issued_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, programId])
  @@index([studentId])
  @@map("certificates")
}
